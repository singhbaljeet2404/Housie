# Public URL of the site (used for canonical URLs, sitemap and lead emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Listing data source: "sample" (fictional data) until the PropTx IDX feed / vendor is live
LISTINGS_PROVIDER=sample

# Map tiles (MapLibre style URL). Defaults to the free OpenFreeMap Positron style.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Lead delivery — configure either or both. With neither, leads are only logged to the server console.
# RESEND_API_KEY=
# LEAD_EMAIL_TO=you@example.com
# LEAD_EMAIL_FROM=Website Leads <leads@yourdomain.ca>
# LEAD_WEBHOOK_URL=   # e.g. a Zapier/Make hook or CRM endpoint; receives the lead as JSON
